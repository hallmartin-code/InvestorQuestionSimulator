# Copy to .env for local development. Never commit .env or real credentials.

# development | production | test. Production requires ANTHROPIC_API_KEY (unless LLM_ENABLED=false),
# enables Secure cookies and HSTS, and requires https for analytics.
APP_ENV=development

# --- Required in production ------------------------------------------------------------
# Anthropic API key for extraction, question generation, answer scoring and coaching.
ANTHROPIC_API_KEY=

# --- Access (optional) ------------------------------------------------------------------
# Leave blank for an open system anyone with the URL can use. Set a shared token (16+ characters)
# to require sign-in.
IC_APP_TOKEN=

# --- TEN Capital analytics (optional; both or neither) -----------------------------------
TEN_ANALYTICS_ENDPOINT=
TEN_ANALYTICS_API_KEY=

# --- Results email (Resend, optional) ----------------------------------------------------
# With a key set, every finished interview is emailed (summary + one-page PDF) to EMAIL_TO.
# The founder's answers (session JSON) are attached only with data-storage consent, and their
# name/email are included only with follow-up consent.
RESEND_API_KEY=
EMAIL_ENABLED=true
# Comma-separated; configuration only, never user input.
EMAIL_TO=Info@tencapital.group
# Must be on a domain verified at resend.com/domains.
EMAIL_FROM=TEN Capital Interview Simulator <reports@tencapital.group>
EMAIL_REPLY_TO=
EMAIL_ATTACH_PDF=true
EMAIL_ATTACH_JSON=true
# true = email only sessions where the founder granted data-storage consent.
EMAIL_REQUIRES_STORAGE_CONSENT=false

# --- Uploads and retention --------------------------------------------------------------
MAX_UPLOAD_MB=25
# Sessions (extracted deck text, answers, report) are deleted after this many hours.
DATA_RETENTION_HOURS=24
# Restricted parse directory (default: <system temp>/ten-iqs-uploads). Files live there only while parsing.
UPLOAD_DIR=

# --- Model (optional) -------------------------------------------------------------------
LLM_ENABLED=true
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
LLM_QUESTION_EFFORT=medium
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=2
# Server-side refusal fallbacks (beta). Set false if your account does not support them.
LLM_USE_FALLBACKS=true

# --- Interview (optional) ---------------------------------------------------------------
INTERVIEW_MAX_QUESTIONS=12
INTERVIEW_MAX_FOLLOWUPS_PER_TOPIC=2

# --- Web (optional) ---------------------------------------------------------------------
# Defaults to true in production. Set explicitly when serving over plain http in staging.
SESSION_COOKIE_SECURE=
ANALYTICS_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
